# App Ports
PORT_API=3000
PORT_CLIENT=3001
PORT_ADMIN=3002

# Database & Caching
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nnep_dev?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# Storage
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="nnep-storage"

# Security
JWT_SECRET="nnep-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="nnep-super-secret-refresh-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"
