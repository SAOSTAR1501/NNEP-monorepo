{
  "name": "@nnep/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build",
    "build": "tsc -b && vite build --config vite.background.config.ts && vite build --config vite.bridge.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@nnep/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "terser": "^5.39.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
